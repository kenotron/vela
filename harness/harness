#!/usr/bin/env bash
# Vela client harness — runs the exact Android normalizer logic against the live server.
# Usage:
#   ./harness/harness "your message"
#   ./harness/harness --session SESS_ID "follow-up"
#   VELA_HOST=http://1.2.3.4:8410 ./harness/harness "hello"
#
# On first run after code changes: rebuilds the fat JAR (~15s).
# On subsequent runs: uses cached JAR directly (~1s startup).

cd "$(dirname "$0")"

SESSION_ID=""
PROMPT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session) SESSION_ID="$2"; shift 2 ;;
    *) PROMPT="${PROMPT}${PROMPT:+ }$1"; shift ;;
  esac
done

if [[ -z "$PROMPT" ]]; then
  echo "Usage: harness [--session SESS_ID] \"your message\""
  exit 1
fi

JAR="build/libs/vela-harness.jar"

# Rebuild JAR if source is newer than the JAR
NEEDS_BUILD=false
if [[ ! -f "$JAR" ]]; then
  NEEDS_BUILD=true
elif find src -name "*.kt" -newer "$JAR" 2>/dev/null | grep -q .; then
  NEEDS_BUILD=true
fi

if $NEEDS_BUILD; then
  echo "Building harness..." >&2
  ./gradlew -q shadowJar 2>&1 | tail -2 >&2 || exit 1
fi

# Write prompt to temp file (avoids JVM arg quoting issues)
TMPFILE=$(mktemp)
printf '%s' "$PROMPT" > "$TMPFILE"
trap 'rm -f "$TMPFILE"' EXIT

VELA_PROMPT_FILE="$TMPFILE" \
VELA_SESSION_ID="$SESSION_ID" \
  java -jar "$JAR" 2>&1
