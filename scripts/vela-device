#!/usr/bin/env bash
# Discover and return the ADB serial for the Vela device.
# Usage:
#   ./scripts/vela-device              # print serial, connect if needed
#   adb -s $(./scripts/vela-device) logcat ...
#
# Identifies the device by hardware serial (stable across networks/ports).
# Works with both classic IP:port wireless and mDNS TLS (Android 12+).

set -uo pipefail

HW_SERIAL="58121FDCH002PR"

# 1. Already connected? (matches any transport: USB, IP:port, or mDNS TLS)
SERIAL=$(adb devices -l 2>/dev/null | grep "$HW_SERIAL" | awk '{print $1}' | head -1 || true)
if [ -n "$SERIAL" ]; then
  echo "$SERIAL"
  exit 0
fi

# 2. Discover via mDNS and connect (Android 12+ wireless debugging)
MDNS_ADDR=$(adb mdns services 2>/dev/null \
  | grep "$HW_SERIAL" \
  | grep "_adb-tls-connect" \
  | awk '{print $NF}' \
  | head -1 || true)
if [ -n "$MDNS_ADDR" ]; then
  adb connect "$MDNS_ADDR" >/dev/null 2>&1 || true
  SERIAL=$(adb devices -l 2>/dev/null | grep "$HW_SERIAL" | awk '{print $1}' | head -1 || true)
  echo "${SERIAL:-$MDNS_ADDR}"
  exit 0
fi

echo "ERROR: Vela device ($HW_SERIAL) not found" >&2
echo "  Enable wireless debugging on the phone and ensure ADB is paired" >&2
exit 1
