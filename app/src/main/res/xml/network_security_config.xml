<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration for Vela.

    Vela is a developer tool that communicates with user-controlled amplifierd
    daemons running on private networks (LAN, Tailscale VPN, etc.).  Those daemons
    expose a plain HTTP API — no TLS — because they are designed for trusted local
    use only.  Android 9+ blocks cleartext HTTP by default, so we must opt in.

    We allow cleartext HTTP globally.  This is appropriate because:
      • All amplifierd endpoints are on private, user-controlled networks.
      • The app never contacts public Internet APIs over cleartext.
      • TLS would require certificate management which is out of scope for a
        local developer daemon.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
